import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.metrics import mean_squared_error, mean_absolute_error
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import GRU, Dense
from tensorflow.keras.callbacks import EarlyStopping
from pathlib import Path
import pandas as pd

BASE_DIR  = Path("/content/drive/MyDrive/project_5G")
FILE_PATH = BASE_DIR / "lstm_ready_aggregated.csv"

df = pd.read_csv(FILE_PATH)
data = df[['cpu_usage', 'memory_usage']].values

SEQ_LEN = 20
EPOCHS = 40

BATCH_SIZE = 32

def create_sequences(data, seq_len, horizon):
    X, y = [], []
    for i in range(len(data) - seq_len - horizon):
        X.append(data[i:i+seq_len])
        y.append(data[i+seq_len:i+seq_len+horizon])
    return np.array(X), np.array(y)

def build_gru(output_steps):
    model = Sequential([
        GRU(64, input_shape=(SEQ_LEN, 2)),
        Dense(output_steps * 2)
    ])
    model.compile(optimizer='adam', loss='mse')
    return model

def MAPE(y_true, y_pred):
    return np.mean(np.abs((y_true - y_pred) / (y_true + 1e-8))) * 100

def run_gru(data, horizon):

    X, y = create_sequences(data, SEQ_LEN, horizon)

    n = len(X)
    train_end = int(n * 0.8)
    val_end = int(n * 0.9)

    X_train, y_train = X[:train_end], y[:train_end]
    X_val, y_val = X[train_end:val_end], y[train_end:val_end]
    X_test, y_test = X[val_end:], y[val_end:]

    model = build_gru(horizon)

    early_stop = EarlyStopping(
        monitor='val_loss',
        patience=7,
        min_delta=1e-6,
        restore_best_weights=True,
        verbose=1
    )

    history = model.fit(
        X_train,
        y_train.reshape(len(y_train), -1),
        validation_data=(X_val, y_val.reshape(len(y_val), -1)),
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        callbacks=[early_stop],

        verbose=1
    )

    pred = model.predict(X_test)

    y_test = y_test.reshape(len(y_test), -1)

    mse = mean_squared_error(y_test, pred)
    mae = mean_absolute_error(y_test, pred)
    mape = MAPE(y_test, pred)

    print(f"\nHorizon {horizon}")
    print("MSE:", mse)
    print("MAE:", mae)
    print("MAPE:", mape)

    plt.figure(figsize=(10, 4))
    plt.plot(y_test[:100, 0], label='Actual')
    plt.plot(pred[:100, 0], label='Predicted')
    plt.title(f'GRU Forecast Horizon {horizon}')
    plt.xlabel('Sample')
    plt.ylabel('Value')
    plt.legend()
    plt.grid(True)
    plt.show()

    plt.figure(figsize=(8, 4))
    plt.plot(history.history['loss'], label='Train Loss')
    plt.plot(history.history['val_loss'], label='Validation Loss')
    plt.title(f'Loss Curve Horizon {horizon}')
    plt.xlabel('Epoch')
    plt.ylabel('Loss')
    plt.legend()
    plt.grid(True)
    plt.show()

run_gru(data, 5)
run_gru(data, 15)
