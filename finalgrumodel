import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error, mean_absolute_error

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import GRU, Dense, Dropout
from tensorflow.keras.callbacks import EarlyStopping

from pathlib import Path


# Settings

BASE_DIR  = Path("/content/drive/MyDrive/project_5G")
FILE_PATH = BASE_DIR / "lstm_ready_aggregated.csv"

SEQ_LEN    = 24
EPOCHS     = 40        
BATCH_SIZE = 32
PATIENCE   = 10       
COLOR_ACTUAL    = "#6A0DAD"
COLOR_PREDICTED = "#FF69B4"
COLOR_TRAIN     = "#8A2BE2"
COLOR_VAL       = "#FFC0CB"


#  Load data 

df   = pd.read_csv(FILE_PATH)
data = df[['cpu_usage']].values.astype(np.float32)
print("Total samples:", len(data))


# Helper functions 

def create_sequences(data, seq_len, horizon):
    X, y = [], []
    for i in range(len(data) - seq_len - horizon + 1):
        X.append(data[i : i + seq_len])
        y.append(data[i + seq_len : i + seq_len + horizon])
    return np.array(X), np.array(y)


def MAPE(y_true, y_pred):
    return np.mean(np.abs((y_true - y_pred) / (y_true + 1e-8))) * 100


def print_metrics(y_true, y_pred, label=""):
    y_true_flat = y_true.reshape(-1)
    y_pred_flat = y_pred.reshape(-1)

    mse  = mean_squared_error(y_true_flat, y_pred_flat)
    mae  = mean_absolute_error(y_true_flat, y_pred_flat)
    mape = MAPE(y_true_flat, y_pred_flat)

    print(f"\n{label} Metrics:")
    print(f"  MSE  : {mse:.6f}")
    print(f"  MAE  : {mae:.6f}")
    print(f"  MAPE : {mape:.2f}%")

    return mse, mae, mape


#  Model 

def build_gru(horizon):
    model = Sequential([
        GRU(64, input_shape=(SEQ_LEN, 1), return_sequences=True),
        Dropout(0.2),
        GRU(64),
        Dropout(0.2),
        Dense(horizon)
    ])
    model.compile(optimizer='adam', loss='mse')
    return model


#  Main function 

def run_gru(data, horizon):

    print(f"\n{'='*55}")
    print(f"  GRU  — Horizon H={horizon}")
    print(f"{'='*55}")

    # Split
    n         = len(data)
    train_end = int(n * 0.80)
    val_end   = int(n * 0.90)

    train_raw = data[:train_end]
    val_raw   = data[train_end:val_end]
    test_raw  = data[val_end:]

    print(f"Train: {len(train_raw)} | Val: {len(val_raw)} | Test: {len(test_raw)}")

    # Scaling
    scaler       = MinMaxScaler()
    train_scaled = scaler.fit_transform(train_raw)
    val_scaled   = scaler.transform(val_raw)
    test_scaled  = scaler.transform(test_raw)

    # Sequences
    X_train, y_train = create_sequences(train_scaled, SEQ_LEN, horizon)
    X_val,   y_val   = create_sequences(val_scaled,   SEQ_LEN, horizon)
    X_test,  y_test  = create_sequences(test_scaled,  SEQ_LEN, horizon)

    print(f"X_train: {X_train.shape} | X_val: {X_val.shape} | X_test: {X_test.shape}")

    # Flatten targets to (batch, horizon)
    y_train_flat = y_train.reshape(len(y_train), horizon)
    y_val_flat   = y_val.reshape(len(y_val),   horizon)
    y_test_flat  = y_test.reshape(len(y_test),  horizon)

    # Build model
    model = build_gru(horizon)
    model.summary()

    early_stop = EarlyStopping(
        monitor='val_loss',
        patience=PATIENCE,
        min_delta=1e-6,
        restore_best_weights=True,
        verbose=1
    )

    # Training
    history = model.fit(
        X_train,
        y_train_flat,
        validation_data=(X_val, y_val_flat),
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        callbacks=[early_stop],
        verbose=1
    )

    best_epoch = np.argmin(history.history['val_loss']) + 1
    print(f"\n  Best epoch: {best_epoch} (val loss: {min(history.history['val_loss']):.6f})")

    # Predict
    pred_scaled = model(X_test, training=False).numpy()

    # Inverse transform
    y_test_inv = scaler.inverse_transform(y_test_flat)
    pred_inv   = scaler.inverse_transform(pred_scaled)

    # Metrics
    mse, mae, mape = print_metrics(y_test_inv, pred_inv, label="CPU Usage")

    # Plot 1: Forecast 
    fig, ax = plt.subplots(figsize=(12, 4))
    ax.plot(y_test_inv[:80, 0], label='Actual',    color=COLOR_ACTUAL,    linewidth=1.5)
    ax.plot(pred_inv[:80, 0],   label='Predicted', color=COLOR_PREDICTED, linewidth=1.5, linestyle='--')
    ax.set_title(f'GRU Forecast — H={horizon} | CPU Usage', fontsize=13, fontweight='bold')
    ax.set_xlabel('Test Sample Index')
    ax.set_ylabel('CPU Usage')
    ax.legend()
    ax.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(BASE_DIR / f"gru_forecast_h{horizon}.png", dpi=120)
    plt.show()

    # Plot 2: Loss 
    plt.figure(figsize=(8, 4))
    plt.plot(history.history['loss'],     label='Train Loss', color=COLOR_TRAIN, linewidth=1.5)
    plt.plot(history.history['val_loss'], label='Val Loss',   color=COLOR_VAL,   linewidth=1.5, linestyle='--')
    plt.axvline(x=best_epoch - 1, color='gray', linestyle=':', linewidth=1.2,
                label=f'Best epoch ({best_epoch})')
    plt.title(f'Training & Validation Loss — H={horizon}', fontsize=13, fontweight='bold')
    plt.xlabel('Epoch')
    plt.ylabel('Loss (MSE)')
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(BASE_DIR / f"gru_loss_h{horizon}.png", dpi=120)
    plt.show()

    return mse, mae, mape


# Run

results = []

for h in [5, 10]:
    mse, mae, mape = run_gru(data, h)
    results.append({"Model": "GRU", "Horizon": h, "MSE": mse, "MAE": mae, "MAPE (%)": mape})

results_df = pd.DataFrame(results)
print("\nGRU Results:")
print(results_df)

results_df.to_csv(BASE_DIR / "gru_results.csv", index=False)
print("\nSaved: gru_results.csv")
