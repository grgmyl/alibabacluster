import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path

from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_squared_error, mean_absolute_error

import torch
import torch.nn as nn
from torch.utils.data import TensorDataset, DataLoader


# Settings

BASE_DIR  = Path("/content/drive/MyDrive/project_5G")
FILE_PATH = BASE_DIR / "lstm_ready_aggregated.csv"

LOOKBACK   = 24
EPOCHS     = 40        # same as GRU
BATCH_SIZE = 32
LR         = 1e-3

PATIENCE  = 10         # same for both horizons (was 12 / 6)
MIN_DELTA = 1e-6

HORIZONS_CONFIG = {
    "Short (H=5)":  {"horizon": 5},
    "Long (H=10)":  {"horizon": 10},
}

COLOR_ACTUAL    = "#6A0DAD"
COLOR_PREDICTED = "#FF69B4"
COLOR_TRAIN     = "#8A2BE2"
COLOR_VAL       = "#FFC0CB"

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print("Using device:", device)


# Load data 

df         = pd.read_csv(FILE_PATH)
cpu_values = df[["cpu_usage"]].values.astype(np.float32)
print("Total samples:", len(cpu_values))


#  Helper function

def create_sequences(data, lookback, horizon):
    X, y = [], []
    for i in range(len(data) - lookback - horizon + 1):
        X.append(data[i : i + lookback])
        y.append(data[i + lookback : i + lookback + horizon])
    return np.array(X, dtype=np.float32), np.array(y, dtype=np.float32)


def inverse_scale(arr, scaler):
    n, h, f = arr.shape
    flat = arr.reshape(-1, f)
    inv  = scaler.inverse_transform(flat)
    return inv.reshape(n, h, f)


def compute_mape(y_true, y_pred, eps=1e-8):
    return np.mean(np.abs((y_true - y_pred) / (np.abs(y_true) + eps))) * 100


def print_metrics(y_true, y_pred, label=""):
    y_true_flat = y_true.reshape(-1)
    y_pred_flat = y_pred.reshape(-1)

    mse  = mean_squared_error(y_true_flat, y_pred_flat)
    mae  = mean_absolute_error(y_true_flat, y_pred_flat)
    mape = compute_mape(y_true_flat, y_pred_flat)

    print(f"\n{label} Metrics:")
    print(f"  MSE  : {mse:.6f}")
    print(f"  MAE  : {mae:.6f}")
    print(f"  MAPE : {mape:.2f}%")

    return mse, mae, mape


# LSTM model

class LSTMModel(nn.Module):
    def __init__(self, horizon):
        super().__init__()
        self.horizon = horizon

        self.lstm = nn.LSTM(
            input_size=1,
            hidden_size=64,
            num_layers=2,
            batch_first=True,
            dropout=0.2      
        )
        self.fc = nn.Linear(64, horizon * 1)

    def forward(self, x):
        out, _ = self.lstm(x)
        out = out[:, -1, :]
        out = self.fc(out)
        return out.view(-1, self.horizon, 1)


# Train / val / test split

n         = len(cpu_values)
train_end = int(n * 0.80)
val_end   = int(n * 0.90)

train_raw = cpu_values[:train_end]
val_raw   = cpu_values[train_end:val_end]
test_raw  = cpu_values[val_end:]

print(f"\nTrain: {len(train_raw)} | Val: {len(val_raw)} | Test: {len(test_raw)}")


#  Main training loop

all_results = []

for horizon_name, horizon_data in HORIZONS_CONFIG.items():
    print(f"\n{'='*55}")
    print(f"  Horizon: {horizon_name}")
    print(f"{'='*55}")

    horizon = horizon_data["horizon"]

    scaler       = MinMaxScaler()
    train_scaled = scaler.fit_transform(train_raw)
    val_scaled   = scaler.transform(val_raw)
    test_scaled  = scaler.transform(test_raw)

    X_train, y_train = create_sequences(train_scaled, LOOKBACK, horizon)
    X_val,   y_val   = create_sequences(val_scaled,   LOOKBACK, horizon)
    X_test,  y_test  = create_sequences(test_scaled,  LOOKBACK, horizon)

    print(f"X_train: {X_train.shape} | X_val: {X_val.shape} | X_test: {X_test.shape}")

    X_train_t = torch.tensor(X_train)
    y_train_t = torch.tensor(y_train)
    X_val_t   = torch.tensor(X_val)
    y_val_t   = torch.tensor(y_val)
    X_test_t  = torch.tensor(X_test)

    train_loader = DataLoader(
        TensorDataset(X_train_t, y_train_t),
        batch_size=BATCH_SIZE,
        shuffle=True
    )

    model     = LSTMModel(horizon=horizon).to(device)
    criterion = nn.MSELoss()
    optimizer = torch.optim.Adam(model.parameters(), lr=LR)

    train_losses = []
    val_losses   = []

    best_val_loss    = float('inf')
    patience_counter = 0
    best_epoch       = 0
    best_model_path  = BASE_DIR / f"best_model_lstm_{horizon_name.split()[0].lower()}.pt"

    for epoch in range(1, EPOCHS + 1):

        # Training phase
        model.train()
        epoch_loss = 0.0

        for X_batch, y_batch in train_loader:
            X_batch = X_batch.to(device)
            y_batch = y_batch.to(device)

            optimizer.zero_grad()
            predictions = model(X_batch)
            loss = criterion(predictions, y_batch)
            loss.backward()
           
            optimizer.step()

            epoch_loss += loss.item()

        train_loss = epoch_loss / len(train_loader)
        train_losses.append(train_loss)

        # Validation
        model.eval()
        with torch.no_grad():
            val_preds = model(X_val_t.to(device))
            val_loss  = criterion(val_preds, y_val_t.to(device)).item()
        val_losses.append(val_loss)

        print(f"  Epoch {epoch:02d}/{EPOCHS} | Train Loss: {train_loss:.6f} | Val Loss: {val_loss:.6f}", end="")

        # Early stopping
        if val_loss < best_val_loss - MIN_DELTA:
            best_val_loss    = val_loss
            patience_counter = 0
            best_epoch       = epoch
            torch.save(model.state_dict(), best_model_path)
            print("  ✓ best model saved")
        else:
            patience_counter += 1
            print(f"  (no improvement {patience_counter}/{PATIENCE})")
            if patience_counter >= PATIENCE:
                print(f"\n  ⚑ Early stopping at epoch {epoch}. Best epoch: {best_epoch}")
                break

    # Restore best weights
    model.load_state_dict(torch.load(best_model_path))
    print(f"  Restored best model from epoch {best_epoch} (val loss: {best_val_loss:.6f})")

    # Predict on test set
    model.eval()
    with torch.no_grad():
        test_preds = model(X_test_t.to(device)).cpu().numpy()

    y_test_inv     = inverse_scale(y_test,     scaler)
    preds_test_inv = inverse_scale(test_preds, scaler)

    mse, mae, mape = print_metrics(y_test_inv, preds_test_inv, label="CPU Usage")

    all_results.append({
        "Horizon"   : horizon_name,
        "Model"     : "LSTM",
        "Best Epoch": best_epoch,
        "MSE"       : mse,
        "MAE"       : mae,
        "MAPE (%)"  : mape
    })

    #  Plot 1: Actual vs Predict
    fig, ax = plt.subplots(figsize=(12, 4))
    ax.plot(y_test_inv[:80, 0, 0],     label='Actual',    color=COLOR_ACTUAL,    linewidth=1.5)
    ax.plot(preds_test_inv[:80, 0, 0], label='Predicted', color=COLOR_PREDICTED, linewidth=1.5, linestyle='--')
    ax.set_title(f'LSTM Forecast — {horizon_name} | CPU Usage', fontsize=13, fontweight='bold')
    ax.set_xlabel('Test Sample Index')
    ax.set_ylabel('CPU Usage')
    ax.legend()
    ax.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(BASE_DIR / f"lstm_forecast_{horizon_name.split()[0].lower()}.png", dpi=120)
    plt.show()

    # Plot 2: Training & Validation Loss
    plt.figure(figsize=(8, 4))
    plt.plot(train_losses, label='Train Loss', color=COLOR_TRAIN, linewidth=1.5)
    plt.plot(val_losses,   label='Val Loss',   color=COLOR_VAL,   linewidth=1.5, linestyle='--')
    plt.axvline(x=best_epoch - 1, color='gray', linestyle=':', linewidth=1.2,
                label=f'Best epoch ({best_epoch})')
    plt.title(f'Training & Validation Loss — {horizon_name}', fontsize=13, fontweight='bold')
    plt.xlabel('Epoch')
    plt.ylabel('Loss (MSE)')
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig(BASE_DIR / f"lstm_loss_{horizon_name.split()[0].lower()}.png", dpi=120)
    plt.show()


# Final results table

results_df = pd.DataFrame(all_results)
print("\nFinal Results:")
print(results_df)

results_df.to_csv(BASE_DIR / "lstm_results.csv", index=False)
print("\nSaved: lstm_results.csv")
